<Window x:Class="GuiFileLAN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GuiFileLAN"
        Title="Gửi File LAN" Height="820" Width="1240" MinHeight="700" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="#F4F7FC" Icon="Assets/app.ico">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#17243A" />
    <SolidColorBrush x:Key="Muted" Color="#687890" />
    <SolidColorBrush x:Key="Accent" Color="#3867F4" />
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="Margin" Value="0,0,0,16" />
      <Setter Property="BorderBrush" Value="#E4EAF3" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="15,10" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#DCE4F0" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#26364F" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#EEF3FC"/><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#C9D5E8"/></Trigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/><Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="primary"/></MultiDataTrigger.Conditions>
                <Setter TargetName="ButtonSurface" Property="Background" Value="#2D56D7"/><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#2D56D7"/>
              </MultiDataTrigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.48"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Tag" Value="primary" />
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
    <DataTemplate x:Key="TransferTemplate">
      <Border BorderBrush="#EDF1F7" BorderThickness="0,0,0,1" Padding="2,12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
          </StackPanel>
          <ProgressBar Grid.Column="1" Height="8" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="{Binding Progress}" Background="#E9EEF8" Foreground="#3867F4" />
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid Margin="26,22,26,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="Assets/logo.png" Width="48" Height="48" Margin="0,0,13,0" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="AppTitleText" Text="Gửi File LAN" FontSize="26" FontWeight="Bold" />
          <TextBlock x:Name="SubtitleText" Text="Chia sẻ file trực tiếp trong mạng Wi-Fi của bạn" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
        </StackPanel>
      </StackPanel>
      <Button x:Name="LanguageButton" Grid.Column="1" Content="VI  ·  EN" Click="SwitchLanguage_Click" VerticalAlignment="Center" Padding="13,9" Margin="0,0,12,0" />
      <Border Grid.Column="2" VerticalAlignment="Center" Background="#E8F7EF" CornerRadius="18" Padding="13,8">
        <TextBlock x:Name="ConnectionStatus" Text="Đang khởi động…" Foreground="#18794E" FontSize="12" FontWeight="SemiBold" />
      </Border>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock x:Name="DevicesTitle" Text="Máy tính trong mạng" Style="{StaticResource SectionTitle}" />
              <TextBlock x:Name="DevicesDescription" Text="Mở ứng dụng trên máy nhận để máy xuất hiện ở đây." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12" />
              <ListBox x:Name="PeersList" MinHeight="115" MaxHeight="200" BorderThickness="0" Background="#F7F9FD" DisplayMemberPath="Display" SelectionChanged="PeersList_SelectionChanged" />
              <TextBlock x:Name="NoPeersHint" Text="Đang tìm máy tính cùng mạng…" Foreground="#8191A8" FontSize="12" Margin="2,9,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock x:Name="SendTitle" Text="Chọn nội dung gửi" Style="{StaticResource SectionTitle}" />
              <TextBlock x:Name="SendDescription" Text="Gửi một hoặc nhiều file, hoặc giữ nguyên cấu trúc thư mục." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,14" />
              <WrapPanel>
                <Button x:Name="FilesButton" Click="ChooseFiles_Click" Style="{StaticResource PrimaryButton}" Content="Chọn file" />
                <Button x:Name="FolderButton" Click="ChooseFolder_Click" Content="Chọn thư mục" />
                <Button x:Name="ClearSelectionButton" Click="ClearSelection_Click" IsEnabled="False" Content="Bỏ chọn" />
              </WrapPanel>
              <TextBlock x:Name="SelectionSummary" Text="Chưa chọn file nào" Foreground="{StaticResource Muted}" FontSize="12" Margin="1,7,0,6" />
              <ListBox x:Name="SelectedFilesList" ItemsSource="{Binding Selection}" DisplayMemberPath="RelativePath" MinHeight="54" MaxHeight="112" BorderThickness="0" Background="#F7F9FD" FontSize="12" />
              <Button x:Name="SendButton" Click="Send_Click" Style="{StaticResource PrimaryButton}" Margin="0,15,0,0" IsEnabled="False" Content="Gửi an toàn" />
              <Button x:Name="CancelButton" Click="Cancel_Click" Visibility="Collapsed" Margin="0,8,0,0" Content="Hủy lượt gửi" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource Card}" MinHeight="218">
            <DockPanel>
              <TextBlock x:Name="TransfersTitle" DockPanel.Dock="Top" Text="Lượt truyền" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
              <ListBox x:Name="TransfersList" ItemsSource="{Binding Transfers}" ItemTemplate="{StaticResource TransferTemplate}" BorderThickness="0" Background="Transparent" />
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Card}" MinHeight="105">
            <DockPanel>
              <TextBlock x:Name="RecentTitle" DockPanel.Dock="Top" Text="Gần đây" Style="{StaticResource SectionTitle}" Margin="0,0,0,7" />
              <ListBox x:Name="RecentList" ItemsSource="{x:Static local:RecentTransfers.Items}" BorderThickness="0" Background="Transparent" FontSize="12" Foreground="{StaticResource Muted}" />
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock x:Name="SaveTitle" Text="Nơi lưu file nhận" Style="{StaticResource SectionTitle}" />
              <TextBlock x:Name="SaveDescription" Text="File chỉ được lưu sau khi bạn chấp thuận lượt nhận." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12" />
              <TextBox x:Name="ReceiveFolderBox" IsReadOnly="True" Padding="10" Background="#F7F9FD" BorderBrush="#E1E8F2" />
              <Button x:Name="ChooseReceiveFolderButton" Click="ChooseReceiveFolder_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Content="Đổi thư mục lưu" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Grid Grid.Row="2" Margin="2,8,2,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="FooterStatus" Text="File được truyền trực tiếp và mã hóa trong mạng nội bộ." Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="DeveloperText" Grid.Column="1" Text="Phát triển bởi PhuDong · 0766771509" Foreground="#8795A9" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
    </Grid>
  </Grid>
</Window>
